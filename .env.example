# Backlot Studio — example environment configuration (no secrets)
# Copy to .env and fill in values from your own Postgres/Supabase project.

# --- Browser-visible (safe to ship in the client bundle) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server-only (never expose to the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI providers (server-only) ---
# Managed gateway used while running on Lovable; swap for your own provider keys later.
LOVABLE_API_KEY=

# --- Video generation providers (server-only, phase 7) ---
# VIDEO_PROVIDER=mock | lovable | external | selfhosted
VIDEO_PROVIDER=mock
EXTERNAL_VIDEO_API_URL=
EXTERNAL_VIDEO_API_KEY=
SELF_HOSTED_RENDER_URL=
SELF_HOSTED_RENDER_TOKEN=
